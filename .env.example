# Ключ YouTube Data API v3.
# Получить: Google Cloud Console → APIs & Services → Enable "YouTube Data API v3" → Credentials → API key.
# ВАЖНО: ключ используется только на сервере (route handler /api/youtube) — не импортируйте
# его в клиентские компоненты, иначе он попадёт в публичный бандл.
YOUTUBE_API_KEY=
